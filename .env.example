# Local development only.
#
# In the Databricks App runtime, attaching a Lakebase database as a resource
# injects PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD automatically.

# Optional Postgres connection string for local dev (overrides the PG* vars).
DATABASE_URL=

# Schema that holds the stock tables (created automatically by the app).
PG_SCHEMA=stock
