# Local development only. In the Databricks App runtime these are injected
# automatically when you attach a SQL warehouse as an app resource.

# SQL warehouse Server Hostname (from Advanced options > JDBC/ODBC).
DATABRICKS_SERVER_HOSTNAME=

# SQL warehouse HTTP Path (from Advanced options > JDBC/ODBC).
DATABRICKS_HTTP_PATH=

# Personal access token for local development.
DATABRICKS_TOKEN=

# Catalog and schema that hold the freezer tables (see sql/schema.sql).
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=freezer
