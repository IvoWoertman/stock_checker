# Local development only.
#
# In the Databricks App runtime, the app's service-principal OAuth credentials
# (DATABRICKS_CLIENT_ID / DATABRICKS_CLIENT_SECRET) and DATABRICKS_HOST are
# injected automatically, and the SQL warehouse is exposed by ID via
# app.yaml `valueFrom: sql-warehouse`. You do not set these locally.

# SQL warehouse Server Hostname (from Advanced options > JDBC/ODBC).
DATABRICKS_SERVER_HOSTNAME=

# SQL warehouse HTTP Path (from Advanced options > JDBC/ODBC).
DATABRICKS_HTTP_PATH=

# Personal access token for local development.
DATABRICKS_TOKEN=

# Catalog and schema that hold the stock tables (see sql/schema.sql).
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=stock
